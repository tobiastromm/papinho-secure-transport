+/*
+ * Generate close_notify once, then make factual progress on any ciphertext
+ * retained by ssl3_SendRecord.  In nonblocking mode SSL3_SendAlert reports
+ * that the two plaintext alert bytes were accepted even when the resulting
+ * record remains in pendingBuf.  Native SEND shutdown must not precede the
+ * complete drain of that record.
+ *
+ * Caller holds the SSL socket writer lock.  This function performs at most
+ * one lower-layer write attempt per call so PR_WOULD_BLOCK_ERROR remains an
+ * incremental readiness contract rather than an internal retry loop.
+ */
+static SECStatus
+ssl_SendCloseNotify(sslSocket *ss)
+{
+    int sent = 0;
+
+    if (!ss->closeNotifyQueued) {
+        SECStatus rv = SSL3_SendAlert(ss, alert_warning, close_notify);
+        if (rv != SECSuccess) {
+            return rv;
+        }
+        ss->closeNotifyQueued = PR_TRUE;
+    }
+
+    ssl_GetXmitBufLock(ss);
+    if (ss->pendingBuf.len != 0) {
+        sent = ssl_SendSavedWriteData(ss);
+        if (sent < 0) {
+            ssl_ReleaseXmitBufLock(ss);
+            return SECFailure;
+        }
+        if (ss->pendingBuf.len != 0) {
+            PORT_SetError(PR_WOULD_BLOCK_ERROR);
+            ssl_ReleaseXmitBufLock(ss);
+            return SECFailure;
+        }
+    }
+    ssl_ReleaseXmitBufLock(ss);
+    return SECSuccess;
+}
+
 /* Caller handles all locking */
