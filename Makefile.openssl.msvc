CC=cl
LIBTOOL=lib
BUILD=build\win64-modern-msvc-openssl
OPENSSL_ROOT=third_party\openssl\prebuilt\win64-msvc-3.5.8
OPENSSL_INCLUDE=$(OPENSSL_ROOT)\include
OPENSSL_LIB=$(OPENSSL_ROOT)\lib
OPENSSL_RUNTIME=$(OPENSSL_ROOT)\runtime
LDFLAGS=/link
CFLAGS=/nologo /W4 /O2 /TC /MD /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /Iinclude /Isrc
OSSL_CFLAGS=$(CFLAGS) /I$(OPENSSL_INCLUDE)
CORE=$(BUILD)\pst_version.obj $(BUILD)\pst_result.obj $(BUILD)\pst_diagnostic.obj $(BUILD)\pst_log.obj $(BUILD)\pst_validation.obj $(BUILD)\pst_identity.obj $(BUILD)\pst_backend.obj $(BUILD)\pst_runtime.obj $(BUILD)\pst_transport_win32.obj
PSTLIB=$(BUILD)\papinho_secure_transport.lib
all: dirs $(PSTLIB) $(BUILD)\test_public_header.exe $(BUILD)\test_backend_openssl.exe $(BUILD)\libcrypto-3-x64.dll $(BUILD)\libssl-3-x64.dll

dirs:
	@if not exist build mkdir build
	@if not exist $(BUILD) mkdir $(BUILD)

$(BUILD)\pst_version.obj: src\pst_version.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_result.obj: src\pst_result.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_diagnostic.obj: src\pst_diagnostic.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_log.obj: src\pst_log.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_validation.obj: src\pst_validation.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_identity.obj: src\pst_identity.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_backend.obj: src\pst_backend.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_runtime.obj: src\pst_runtime.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_transport_win32.obj: src\platform\win32\pst_transport_win32.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\pst_backend_openssl.obj: src\backends\openssl\pst_backend_openssl.c
	$(CC) $(OSSL_CFLAGS) /Fo$@ /c $**
$(PSTLIB): $(CORE)
	$(LIBTOOL) /nologo /out:$@ $(CORE)
$(BUILD)\test_public_header.obj: tests\test_public_header.c
	$(CC) $(CFLAGS) /Fo$@ /c $**
$(BUILD)\test_public_header.exe: $(BUILD)\test_public_header.obj $(PSTLIB)
	$(CC) /nologo /Fe$@ $** $(LDFLAGS)
$(BUILD)\test_backend_openssl.obj: tests\test_backend_openssl.c
	$(CC) $(OSSL_CFLAGS) /Fo$@ /c $**
$(BUILD)\test_backend_openssl.exe: $(BUILD)\test_backend_openssl.obj $(BUILD)\pst_backend_openssl.obj $(PSTLIB)
	$(CC) /nologo /Fe$@ $** $(LDFLAGS) /LIBPATH:$(OPENSSL_LIB) libcrypto.lib ws2_32.lib

$(BUILD)\libcrypto-3-x64.dll: $(OPENSSL_RUNTIME)\libcrypto-3-x64.dll
	copy /y $** $@ >nul
$(BUILD)\libssl-3-x64.dll: $(OPENSSL_RUNTIME)\libssl-3-x64.dll
	copy /y $** $@ >nul

test: all
	$(BUILD)\test_public_header.exe
	$(BUILD)\test_backend_openssl.exe

clean:
	@if exist $(BUILD) rmdir /s /q $(BUILD)
